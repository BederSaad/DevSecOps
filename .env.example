# ==============================================================================
# .env.example — Copy this to .env and fill in real values.
# NEVER commit .env to git (it is in .gitignore).
# ==============================================================================

# MySQL credentials (choose strong passwords, min 16 chars recommended)
MYSQL_ROOT_PASSWORD=change_me_root_password_here
MYSQL_DATABASE=studentdb
MYSQL_USERNAME=studentapp
MYSQL_PASSWORD=change_me_app_password_here

# Docker image tag — set by CI/CD to the commit SHA for immutable deploys
# Locally you can use: latest
IMAGE_TAG=latest

# Cloudflare Tunnel token — get from https://one.dash.cloudflare.com/
# Tunnels → Create a tunnel → Copy the token shown in step 2
CLOUDFLARE_TUNNEL_TOKEN=paste_your_cloudflare_tunnel_token_here

# Your public domain (used for CORS)
# Examples:
#   https://student.yourdomain.com
#   https://abc123.cfargotunnel.com   (temporary Cloudflare URL)
PUBLIC_DOMAIN=https://your-domain-here.com
